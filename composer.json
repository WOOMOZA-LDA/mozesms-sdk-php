{
    "name": "mozesms/sdk",
    "description": "SDK oficial PHP da API MozeSMS (SMS, OTP, saldo, webhooks)",
    "type": "library",
    "license": "MIT",
    "keywords": ["sms", "otp", "mozambique", "mozesms"],
    "require": {
        "php": ">=7.4",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": { "MozeSMS\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "MozeSMS\\Tests\\": "tests/" }
    }
}
